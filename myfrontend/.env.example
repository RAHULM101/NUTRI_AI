# ==============================================================================
# NutriAI React Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to a new file named '.env' in this same directory and adjust
# the values below to match your environment. Do NOT commit the '.env' file.

# URL of the Django backend API (local dev is http://localhost:8000)
VITE_BACKEND_URL=http://localhost:8000

# Base URL for API calls (usually the same as VITE_BACKEND_URL)
VITE_API_BASE_URL=http://localhost:8000

# Google Cloud Console OAuth Client ID (for Google OAuth registration/login)
# Must match the GOOGLE_CLIENT_ID configured on the backend
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
