# ==============================================================================
# NutriAI Django Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to a new file named '.env' in this same directory and adjust
# the values below to match your environment. Do NOT commit the '.env' file.

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
SECRET_KEY=your_django_secret_key_here
DEBUG=True
DJANGO_ALLOWED_HOSTS=your_allowed_hosts

# ------------------------------------------------------------------------------
# Database Settings (Local PostgreSQL)
# ------------------------------------------------------------------------------
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=your_database_port

# ------------------------------------------------------------------------------
# Database Settings (Production Deployment on Render / Cloud)
# ------------------------------------------------------------------------------
# If you are deploying to Render/Heroku/AWS, set DATABASE_URL instead of the
# separate DB_* fields. The app automatically detects this variable in production.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ------------------------------------------------------------------------------
# Third-Party API Credentials
# ------------------------------------------------------------------------------
# Google Gemini API key (for meal analysis & AI nutritionist Nia)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Console OAuth Client ID (for Google OAuth registration/login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Email Server Settings (Optional - for sending OTPs and notifications)
# ------------------------------------------------------------------------------
EMAIL_HOST=your_smtp_host
EMAIL_PORT=your_smtp_port
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email_address
EMAIL_HOST_PASSWORD=your_email_password
